{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Build Environment Manifest Schema",
  "type": "object",
  "description": "Schema for build environment variable definitions in UALBF",
  "additionalProperties": false,
  "patternProperties": {
    "^[A-Z0-9_]+$": {
      "type": "object",
      "required": [
        "type",
        "default",
        "status",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "float",
            "boolean",
            "path"
          ]
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "allowed_values": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated",
            "internal"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
